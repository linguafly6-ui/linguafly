{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe coincidir con el Worker de Workers Builds (CI). Ahora: linguaflyapp1.
  "name": "linguaflyapp1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Self-reference: mismo nombre que "name" arriba.
      "service": "linguaflyapp1"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Cloudflare Email Service: enable the domain in the dashboard before deploying.
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["noreply@linguafly.app"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Defense-in-depth limit per IP and route. Use a unique namespace_id per account.
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "610154781",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  // D1 (SQLite) — origen de verdad del contenido público.
  // Migraciones: wrangler d1 migrations apply blog --remote
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "b159641b-1910-49ec-b2ed-fbfae2440377"
      }
    ],
    "ratelimits": [
      {
        "name": "AI_RATE_LIMITER",
        "namespace_id": "610154782",
        "simple": {
          "limit": 30,
          "period": 60
        }
      }
    ],
    "images": {
      "binding": "IMAGES"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog",
      "database_id": "476f34d4-5622-4a56-923e-c4fb571578c2",
      "migrations_dir": "migrations/d1"
    }
  ]
}
