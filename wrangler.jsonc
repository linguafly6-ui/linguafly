{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe coincidir con el Worker de Workers Builds (CI). Ahora: linguaflyapp1.
  "name": "linguaflyapp1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Self-reference: mismo nombre que "name" arriba.
      "service": "linguaflyapp1"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Cloudflare Email Service: enable the domain in the dashboard before deploying.
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["noreply@linguafly.app"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Defense-in-depth limit per IP and route. Use a unique namespace_id per account.
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "610154781",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  // D1 de artículos y D1 de aprendizaje. linguafly-learning es producción.
  // No apuntar COURSE_DB a la antigua base linguafly-preview.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog",
      "database_id": "476f34d4-5622-4a56-923e-c4fb571578c2",
      "migrations_dir": "migrations/d1"
    },
    {
      "binding": "COURSE_DB",
      "database_name": "linguafly-learning",
      "database_id": "0982f4a2-ce92-410a-9e72-e5a34c461612"
    }
  ],
  // Preview utiliza su D1 aislada para cursos y no modifica producción.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "linguafly-preview",
        "database_id": "b159641b-1910-49ec-b2ed-fbfae2440377",
        "migrations_dir": "migrations/d1"
      },
      {
        "binding": "COURSE_DB",
        "database_name": "linguafly-learning-preview",
        "database_id": "7e4e332b-6b37-4b4c-905f-390e1ef0f79a"
      }
    ],
    // Deshabilitado en Preview: no se autoriza el envío de correos desde pruebas.
    "send_email": [
      {
        "name": "EMAIL",
        "allowed_sender_addresses": []
      }
    ],
    "ratelimits": [
      {
        "name": "AI_RATE_LIMITER",
        "namespace_id": "610154782",
        "simple": {
          "limit": 30,
          "period": 60
        }
      }
    ],
    "ai": {
      "binding": "AI"
    },
    "images": {
      "binding": "IMAGES"
    }
  }
}
